#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 72
    metersPerUnit = 1
    startTimeCode = 0
    timeCodesPerSecond = 24
    upAxis = "Z"
)

def Xform "World"
{
    def "Materials"
    {
        def Material "Ceiling"
        {
            token outputs:surface.connect = </World/Materials/Ceiling/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.06)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "Floor"
