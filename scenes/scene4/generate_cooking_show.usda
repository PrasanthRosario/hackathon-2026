            color3f inputs:color   = (1.0, 0.97, 0.90)
            double3 xformOp:translate = (0, -1.0, 3.4)
            float3 xformOp:rotateXYZ = (-70, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:rotateXYZ"]
        }

        # Fill Light (left side, softer)
        def DistantLight "FillLight"
        {
            float inputs:intensity = 900
            color3f inputs:color   = (0.85, 0.90, 1.0)
            double3 xformOp:translate = (-4.0, 0, 3.0)
            float3 xformOp:rotateXYZ = (-50, 30, 0)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:rotateXYZ"]
        }

        # Rim / Back Light
        def DistantLight "RimLight"
        {
            float inputs:intensity = 600
            color3f inputs:color   = (1.0, 0.95, 0.80)
            double3 xformOp:translate = (3.0, 3.5, 3.0)
            float3 xformOp:rotateXYZ = (-40, -45, 0)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:rotateXYZ"]
        }

        # Practical Overhead Pendant 1
        def Sphere "Pendant1"
        {
            double radius = 0.12
            double3 xformOp:translate = (-1.5, 1.5, 2.8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(1.0, 0.95, 0.70)]
        }

        # Practical Overhead Pendant 2
        def Sphere "Pendant2"
        {
            double radius = 0.12
            double3 xformOp:translate = (1.5, 1.5, 2.8)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(1.0, 0.95, 0.70)]
        }

        # Pendant Cord 1
        def Cylinder "PendantCord1"
        {
            double radius = 0.01
            double height = 0.55
            double3 xformOp:translate = (-1.5, 1.5, 3.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.20, 0.20, 0.20)]
        }

        # Pendant Cord 2
        def Cylinder "PendantCord2"
        {
            double radius = 0.01
            double height = 0.55
            double3 xformOp:translate = (1.5, 1.5, 3.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.20, 0.20, 0.20)]
        }

        # Softbox Light Stand Left
        def Cylinder "SoftboxStandLeft"
        {
            double radius = 0.03
            double height = 2.2
            double3 xformOp:translate = (-8.0, -1.0, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.30, 0.30, 0.30)]
        }

        def Cube "SoftboxHeadLeft"
        {
            double3 xformOp:translate = (-8.0, -1.0, 2.4)
            double3 xformOp:scale    = (0.50, 0.08, 0.40)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:scale"]
            color3f[] primvars:displayColor = [(0.95, 0.95, 0.95)]
        }

        # Softbox Light Stand Right
        def Cylinder "SoftboxStandRight"
        {
            double radius = 0.03
            double height = 2.2
            double3 xformOp:translate = (8.0, -1.0, 1.1)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f[] primvars:displayColor = [(0.30, 0.30, 0.30)]
        }

        def Cube "SoftboxHeadRight"
        {
            double3 xformOp:translate = (8.0, -1.0, 2.4)
            double3 xformOp:scale    = (0.50, 0.08, 0.40)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:scale"]
            color3f[] primvars:displayColor = [(0.95, 0.95, 0.95)]
        }

        # Ambient Dome
        def DomeLight "AmbientDome"
        {
            float inputs:intensity = 300
            color3f inputs:color   = (0.80, 0.85, 0.90)
        }
    }

    # ─────────────────────────────────────────────
    # CAMERAS
    # ─────────────────────────────────────────────
    def Xform "Cameras"
    {
        # Wide Shot Camera – captures full set
        def Camera "WideCamera"
        {
            float focalLength = 24
            float horizontalAperture = 36
            float verticalAperture   = 24
            double3 xformOp:translate = (0, -7.5, 1.6)
            float3 xformOp:rotateXYZ  = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:rotateXYZ"]
        }

        # Detail / Close-up Camera – focuses on counter
        def Camera "DetailCamera"
        {
            float focalLength = 85
            float horizontalAperture = 36
            float verticalAperture   = 24
            double3 xformOp:translate = (2.5, -2.5, 1.4)
            float3 xformOp:rotateXYZ  = (0, -25, 0)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:rotateXYZ"]
        }

        # Overhead / Hero-shot Camera
        def Camera "OverheadCamera"
        {
            float focalLength = 35
            float horizontalAperture = 36
            float verticalAperture   = 24
            double3 xformOp:translate = (0, 1.5, 3.2)
            float3 xformOp:rotateXYZ  = (-80, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate","xformOp:rotateXYZ"]
        }
    }
}
